<!-- Estilos da interface. Só usa cores por DynamicResource, para a troca de tema valer na hora. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="FonteIcones">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="Icone" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FonteIcones}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}"/>
    </Style>

    <Style x:Key="RotuloGrupo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoSutil}"/>
        <Setter Property="Margin" Value="12,16,0,6"/>
    </Style>

    <!-- Botão padrão: contorno discreto. -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="Background" Value="{DynamicResource Superficie}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Borda}"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Caixa" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Caixa" Property="Background" Value="{DynamicResource Fundo}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Caixa" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                        </Trigger>
                        <!-- Opacidade, não cor: funciona igual no botão comum e no principal. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Caixa" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Uma ação principal por tela. -->
    <!-- Modelo próprio: o hover do botão comum troca o fundo pela cor clara da janela, e o texto (claro) sumia.
         Aqui o fundo continua o acento e só clareia um pouco (ou escurece, apertado). -->
    <Style x:Key="BotaoPrincipal" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource NoAcento}"/>
        <Setter Property="Background" Value="{DynamicResource Acento}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Acento}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Caixa" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Caixa" Property="Opacity" Value="0.86"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Caixa" Property="Opacity" Value="0.72"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Caixa" Property="BorderBrush" Value="{DynamicResource Texto}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Caixa" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cartões do painel de detalhes -->
    <Style x:Key="Cartao" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Superficie}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Borda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="TituloCartao" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoSutil}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="BotaoIcone" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style x:Key="CampoBusca" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Texto}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Barra lateral: grupos não são clicáveis; módulos ficam com fundo de acento quando escolhidos. -->
    <!-- Estilos implícitos de TextBlock não atravessam DataTemplate: a cor do texto vem do Foreground herdado do item. -->
    <Style x:Key="ItemNavegacao" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Margin" Value="6,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Caixa" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Caixa" Property="Background" Value="{DynamicResource Fundo}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Caixa" Property="Background" Value="{DynamicResource AcentoFundo}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tipo}" Value="Grupo">
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Padding" Value="4,10,0,2"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Linhas da lista de alvos: cabeçalhos de categoria não são clicáveis. -->
    <Style x:Key="ItemAlvo" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Caixa" Background="Transparent" BorderBrush="{DynamicResource Borda}"
                            BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Caixa" Property="Background" Value="{DynamicResource Fundo}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Caixa" Property="Background" Value="{DynamicResource AcentoFundo}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tipo}" Value="Categoria">
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Padding" Value="12,16,12,4"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Barra de valor (0 a 100). A cor vem do Foreground, definido por nível na linha. -->
    <Style x:Key="BarraValor" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Foreground" Value="{DynamicResource Acento}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{DynamicResource SuperficieLateral}" CornerRadius="3"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3"
                                HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Caixa de seleção nas cores do tema. -->
    <Style x:Key="Caixa" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Quadro" Width="18" Height="18" CornerRadius="4" BorderThickness="1"
                            BorderBrush="{DynamicResource TextoSutil}" Background="{DynamicResource Superficie}">
                        <TextBlock x:Name="Marca" FontFamily="{StaticResource FonteIcones}" Text="&#xE73E;" FontSize="11"
                                   Foreground="{DynamicResource NoAcento}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Quadro" Property="Background" Value="{DynamicResource Acento}"/>
                            <Setter TargetName="Quadro" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                            <Setter TargetName="Marca" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Quadro" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Quadro" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de rolagem fina, nas cores do tema (a padrão do Windows fica cinza-clara no escuro). -->
    <ControlTemplate x:Key="PolegarRolagem" TargetType="Thumb">
        <Border Background="{DynamicResource Borda}" CornerRadius="4" Margin="2"/>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Template="{StaticResource PolegarRolagem}"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Template="{StaticResource PolegarRolagem}"/>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Barra de progresso de tarefa em segundo plano. -->
    <Style x:Key="BarraTarefa" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Foreground" Value="{DynamicResource Acento}"/>
        <Setter Property="Background" Value="{DynamicResource SuperficieLateral}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ===== Grade (módulos com Visualizacao = 'Grade'): quadros com ícone, nome e selo. ===== -->
    <ItemsPanelTemplate x:Key="PainelGrade">
        <!-- Centralizada: sobra igual dos dois lados. O subtítulo de categoria tem a largura das colunas (LarguraLinhaGrade,
         calculada em Paginas.ps1), não a da janela, para não empurrar a grade para a esquerda. -->
        <WrapPanel Orientation="Horizontal" Margin="8,4,8,8" HorizontalAlignment="Center"/>
    </ItemsPanelTemplate>

    <!-- Quadro; o cabeçalho de categoria ocupa a linha inteira (largura das colunas de quadros, LarguraLinhaGrade). -->
    <Style x:Key="ItemAlvoGrade" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Caixa" Background="{DynamicResource Superficie}" BorderBrush="{DynamicResource Borda}"
                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Caixa" Property="Background" Value="{DynamicResource Fundo}"/>
                        </Trigger>
                        <!-- Marcado: borda de destaque (dá para ver o que foi escolhido sem olhar a caixinha) -->
                        <DataTrigger Binding="{Binding Selecionado}" Value="True">
                            <Setter TargetName="Caixa" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Caixa" Property="Background" Value="{DynamicResource AcentoFundo}"/>
                            <Setter TargetName="Caixa" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Tipo}" Value="Categoria">
                            <Setter TargetName="Caixa" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Caixa" Property="BorderThickness" Value="0"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tipo}" Value="Categoria">
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Margin" Value="4,20,4,4"/>
                <Setter Property="Width" Value="{DynamicResource LarguraLinhaGrade}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="ModeloGrade">
        <Grid>
            <TextBlock x:Name="RotuloCategoria" Text="{Binding Nome}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextoSecundario}" Visibility="Collapsed"/>
            <Grid x:Name="Quadro" Width="{DynamicResource LarguraQuadro}" Height="132">
                <!-- Nome inteiro (o do quadro corta em duas linhas) e o que o item faz -->
                <Grid.ToolTip>
                    <StackPanel MaxWidth="340">
                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detalhe}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid.ToolTip>
                <!-- Categoria pequena no alto (grade sem seções, como a do Status) -->
                <TextBlock x:Name="SobreQuadro" Text="{Binding Sobre}" FontSize="10" Foreground="{DynamicResource TextoSutil}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="8,9,8,0" TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"/>
                <CheckBox x:Name="Caixa" Style="{DynamicResource Caixa}" IsChecked="{Binding Selecionado, Mode=OneWay}"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Visibility="Collapsed"
                          AutomationProperties.Name="{Binding Nome}"/>
                <TextBlock x:Name="Escudo" Style="{DynamicResource Icone}" Text="&#xE83D;" FontSize="12" HorizontalAlignment="Right"
                           VerticalAlignment="Top" Margin="8" Visibility="Collapsed" ToolTip="Pede permissão de administrador"/>
                <!-- Estrela do FMHY (programas recomendados por lá) -->
                <TextBlock x:Name="Estrela" Style="{DynamicResource Icone}" Text="&#xE735;" FontSize="13" HorizontalAlignment="Right"
                           VerticalAlignment="Top" Margin="8" Visibility="Collapsed" Foreground="{DynamicResource Aviso}"
                           ToolTip="Recomendado pelo FMHY" AutomationProperties.Name="Recomendado pelo FMHY"/>
                <StackPanel VerticalAlignment="Center" Margin="6,20,6,8">
                    <!-- Categoria (página Programas, como as pastas do menu Iniciar do Windows 11): 4 ícones grandes -->
                    <Border x:Name="PastaGrande" Width="112" Height="112" CornerRadius="12" Background="{DynamicResource SuperficieLateral}"
                            Padding="8" HorizontalAlignment="Center" Visibility="Collapsed">
                        <UniformGrid Rows="2" Columns="2">
                            <Image Source="{Binding Mini0}" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Image Source="{Binding Mini1}" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Image Source="{Binding Mini2}" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Image Source="{Binding Mini3}" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </UniformGrid>
                    </Border>
                    <!-- Pasta de itens com amostra de texto (página Fonte): o "Aa" das 4 primeiras fontes -->
                    <Border x:Name="PastaTexto" Width="112" Height="112" CornerRadius="12" Background="{DynamicResource SuperficieLateral}"
                            Padding="6" HorizontalAlignment="Center" Visibility="Collapsed">
                        <UniformGrid Rows="2" Columns="2">
                            <Viewbox StretchDirection="DownOnly" MaxWidth="46" MaxHeight="40"><TextBlock Text="{Binding MiniTexto0}" FontFamily="{Binding MiniFonte0}" FontSize="22"/></Viewbox>
                            <Viewbox StretchDirection="DownOnly" MaxWidth="46" MaxHeight="40"><TextBlock Text="{Binding MiniTexto1}" FontFamily="{Binding MiniFonte1}" FontSize="22"/></Viewbox>
                            <Viewbox StretchDirection="DownOnly" MaxWidth="46" MaxHeight="40"><TextBlock Text="{Binding MiniTexto2}" FontFamily="{Binding MiniFonte2}" FontSize="22"/></Viewbox>
                            <Viewbox StretchDirection="DownOnly" MaxWidth="46" MaxHeight="40"><TextBlock Text="{Binding MiniTexto3}" FontFamily="{Binding MiniFonte3}" FontSize="22"/></Viewbox>
                        </UniformGrid>
                    </Border>
                    <!-- Pasta de itens que só têm ícone de categoria (Ajustes): o ícone grande da categoria -->
                    <Border x:Name="PastaGlifo" Width="112" Height="112" CornerRadius="12" Background="{DynamicResource SuperficieLateral}"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="{Binding GlifoPasta}" Style="{DynamicResource Icone}" FontSize="44" Foreground="{DynamicResource Acento}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Amostra grande no lugar do ícone (página Fonte: "Aa" desenhado na própria fonte) -->
                    <TextBlock x:Name="AmostraGrande" Text="{Binding Amostra}" FontFamily="{Binding AmostraFonte}" FontSize="32" Height="46"
                               HorizontalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"/>
                    <Grid x:Name="Icone40" Width="40" Height="40" HorizontalAlignment="Center">
                        <Border x:Name="FundoInicial" CornerRadius="20" Background="{DynamicResource AcentoFundo}">
                            <TextBlock x:Name="LetraInicial" Text="{Binding Inicial}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Acento}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Image x:Name="Imagem" Source="{Binding Imagem}" Width="32" Height="32" Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <!-- Pasta de alternativas: até 4 miniaturas num quadrado, como no menu Iniciar do Windows 11 -->
                        <Border x:Name="FundoPasta" CornerRadius="8" Background="{DynamicResource SuperficieLateral}" Padding="3"
                                Visibility="Collapsed">
                            <UniformGrid Rows="2" Columns="2">
                                <Image Source="{Binding Mini0}" Width="15" Height="15" Margin="1" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Image Source="{Binding Mini1}" Width="15" Height="15" Margin="1" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Image Source="{Binding Mini2}" Width="15" Height="15" Margin="1" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Image Source="{Binding Mini3}" Width="15" Height="15" Margin="1" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </UniformGrid>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="NomeQuadro" Text="{Binding Nome}" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="34" Margin="0,8,0,4"/>
                    <!-- Páginas que só mostram (Status): o valor à vista, com a barra de uso -->
                    <TextBlock x:Name="DetalheQuadro" Text="{Binding Detalhe}" FontSize="10.5" Foreground="{DynamicResource TextoSecundario}"
                               TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30" Margin="0,0,0,4"
                               Visibility="Collapsed"/>
                    <ProgressBar x:Name="BarraQuadro" Style="{DynamicResource BarraValor}" Value="{Binding Valor}" Width="100"
                                 HorizontalAlignment="Center" Margin="0,0,0,4" Visibility="Collapsed"/>
                    <WrapPanel HorizontalAlignment="Center">
                        <!-- Quanto o item libera (Limpar) -->
                        <Border x:Name="TamanhoQuadro" CornerRadius="5" Padding="6,1,6,2" Margin="2,1" Background="{DynamicResource AcentoFundo}"
                                Visibility="Collapsed">
                            <TextBlock Text="{Binding TamanhoTexto}" FontSize="10.5" Foreground="{DynamicResource Acento}"/>
                        </Border>
                        <!-- Classificação do ajuste (Recomendado, Atenção, Arriscado) -->
                        <Border x:Name="ClasseQuadro" CornerRadius="5" Padding="6,1,6,2" Margin="2,1" Background="{DynamicResource SuperficieLateral}"
                                Visibility="Collapsed" ToolTip="{Binding DicaClasse}">
                            <TextBlock x:Name="TextoClasseQuadro" Text="{Binding RotuloClasse}" FontSize="10.5" Foreground="{DynamicResource TextoSecundario}"/>
                        </Border>
                        <Border x:Name="Selo" CornerRadius="5" Padding="6,1,6,2" Margin="2,1"
                                Background="{DynamicResource SuperficieLateral}" Visibility="Collapsed">
                            <TextBlock x:Name="TextoSelo" Text="{Binding Selo}" FontSize="10.5" Foreground="{DynamicResource TextoSecundario}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Tipo}" Value="Categoria">
                <Setter TargetName="RotuloCategoria" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Quadro" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TemImagem}" Value="True">
                <Setter TargetName="Imagem" Property="Visibility" Value="Visible"/>
                <Setter TargetName="FundoInicial" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Estrela}" Value="True">
                <Setter TargetName="Estrela" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tipo}" Value="Secao">
                <Setter TargetName="Quadro" Property="Width" Value="{DynamicResource LarguraPasta}"/>
                <Setter TargetName="Quadro" Property="Height" Value="196"/>
                <Setter TargetName="PastaGrande" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Icone40" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="NomeQuadro" Property="FontSize" Value="14"/>
                <Setter TargetName="NomeQuadro" Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="Selo" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <!-- Item solto entre as pastas de categoria (o "Atualizar tudo"): do tamanho delas, para a grade não desalinhar -->
            <DataTrigger Binding="{Binding Grande}" Value="True">
                <Setter TargetName="Quadro" Property="Width" Value="{DynamicResource LarguraPasta}"/>
                <Setter TargetName="Quadro" Property="Height" Value="196"/>
                <Setter TargetName="Icone40" Property="Width" Value="112"/>
                <Setter TargetName="Icone40" Property="Height" Value="112"/>
                <Setter TargetName="FundoInicial" Property="CornerRadius" Value="12"/>
                <Setter TargetName="FundoInicial" Property="Background" Value="{DynamicResource SuperficieLateral}"/>
                <Setter TargetName="LetraInicial" Property="FontSize" Value="44"/>
                <Setter TargetName="Imagem" Property="Width" Value="64"/>
                <Setter TargetName="Imagem" Property="Height" Value="64"/>
                <Setter TargetName="NomeQuadro" Property="FontSize" Value="14"/>
                <Setter TargetName="NomeQuadro" Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TemAmostra}" Value="True">
                <Setter TargetName="AmostraGrande" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Icone40" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TemMiniTexto}" Value="True">
                <Setter TargetName="PastaTexto" Property="Visibility" Value="Visible"/>
                <Setter TargetName="PastaGrande" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TemGlifoPasta}" Value="True">
                <Setter TargetName="PastaGlifo" Property="Visibility" Value="Visible"/>
                <Setter TargetName="PastaGrande" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <!-- Ícone da categoria no lugar da inicial -->
            <DataTrigger Binding="{Binding TemGlifo}" Value="True">
                <Setter TargetName="LetraInicial" Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                <Setter TargetName="LetraInicial" Property="FontWeight" Value="Normal"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding MostraDetalhe}" Value="True">
                <Setter TargetName="SobreQuadro" Property="Visibility" Value="Visible"/>
                <Setter TargetName="DetalheQuadro" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Quadro" Property="Height" Value="156"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TemValor}" Value="True">
                <Setter TargetName="BarraQuadro" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Nivel}" Value="Atencao">
                <Setter TargetName="DetalheQuadro" Property="Foreground" Value="{DynamicResource Aviso}"/>
                <Setter TargetName="BarraQuadro" Property="Foreground" Value="{DynamicResource Aviso}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Nivel}" Value="Critico">
                <Setter TargetName="DetalheQuadro" Property="Foreground" Value="{DynamicResource Perigo}"/>
                <Setter TargetName="BarraQuadro" Property="Foreground" Value="{DynamicResource Perigo}"/>
            </DataTrigger>
            <!-- Ajuste: classificação e estado ("aplicado · marcar desfaz") podem precisar de duas linhas -->
            <DataTrigger Binding="{Binding TemClasse}" Value="True">
                <Setter TargetName="ClasseQuadro" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Quadro" Property="Height" Value="158"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TemTamanho}" Value="True">
                <Setter TargetName="TamanhoQuadro" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Classe}" Value="Recomendado">
                <Setter TargetName="ClasseQuadro" Property="Background" Value="{DynamicResource SucessoFundo}"/>
                <Setter TargetName="TextoClasseQuadro" Property="Foreground" Value="{DynamicResource Sucesso}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Classe}" Value="Atencao">
                <Setter TargetName="ClasseQuadro" Property="Background" Value="{DynamicResource AvisoFundo}"/>
                <Setter TargetName="TextoClasseQuadro" Property="Foreground" Value="{DynamicResource Aviso}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Classe}" Value="Arriscado">
                <Setter TargetName="ClasseQuadro" Property="Background" Value="{DynamicResource PerigoFundo}"/>
                <Setter TargetName="TextoClasseQuadro" Property="Foreground" Value="{DynamicResource Perigo}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tipo}" Value="Pasta">
                <Setter TargetName="FundoPasta" Property="Visibility" Value="Visible"/>
                <Setter TargetName="FundoInicial" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Selo" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TemCaixa}" Value="True">
                <Setter TargetName="Caixa" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RequerAdmin}" Value="True">
                <Setter TargetName="Escudo" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TemSelo}" Value="True">
                <Setter TargetName="Selo" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <!-- Na grade, "não aplicado" em todo quadro só faz barulho: fica só o que está aplicado ou parcial -->
            <DataTrigger Binding="{Binding Selo}" Value="não aplicado">
                <Setter TargetName="Selo" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Estado}" Value="Aplicado">
                <Setter TargetName="Selo" Property="Background" Value="{DynamicResource SucessoFundo}"/>
                <Setter TargetName="TextoSelo" Property="Foreground" Value="{DynamicResource Sucesso}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Estado}" Value="Parcial">
                <Setter TargetName="Selo" Property="Background" Value="{DynamicResource AvisoFundo}"/>
                <Setter TargetName="TextoSelo" Property="Foreground" Value="{DynamicResource Aviso}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
